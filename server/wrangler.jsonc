{
  // The co-op server. `npm run server` runs it on this PC; `npm run deploy:server` publishes it.
  "name": "zombiesiege-coop",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
